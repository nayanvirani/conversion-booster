{{ 'cb-core.css' | asset_url | stylesheet_tag }}

{%- capture icon_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
{%- capture icon_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6H1v12h2"/><path d="M14 9h4l4 4v5h-2"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>{%- endcapture -%}
{%- capture icon_return -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v6h6"/></svg>{%- endcapture -%}
{%- capture icon_chat -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H4l1.5-3A8 8 0 1 1 21 12z"/></svg>{%- endcapture -%}
{%- capture icon_star -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endcapture -%}
{%- capture icon_lock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>{%- endcapture -%}
{%- capture icon_heart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>{%- endcapture -%}
{%- capture icon_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7v5l3.5 3.5"/></svg>{%- endcapture -%}
{%- capture icon_fire -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg>{%- endcapture -%}
{%- capture icon_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}

<ul class="cb-trust" style="color:{{ block.settings.color }};font-size:{{ block.settings.font_size }}px;" aria-label="Store guarantees">
  {%- if block.settings.badge_1 != blank -%}
    <li class="cb-trust__item">
      {%- case block.settings.icon_1 -%}
        {%- when 'shield' -%}{{ icon_shield }}
        {%- when 'truck' -%}{{ icon_truck }}
        {%- when 'return' -%}{{ icon_return }}
        {%- when 'chat' -%}{{ icon_chat }}
        {%- when 'star' -%}{{ icon_star }}
        {%- when 'lock' -%}{{ icon_lock }}
        {%- when 'heart' -%}{{ icon_heart }}
        {%- when 'clock' -%}{{ icon_clock }}
        {%- when 'fire' -%}{{ icon_fire }}
        {%- when 'check' -%}{{ icon_check }}
      {%- endcase -%}
      {{ block.settings.badge_1 }}
    </li>
  {%- endif -%}
  {%- if block.settings.badge_2 != blank -%}
    <li class="cb-trust__item">
      {%- case block.settings.icon_2 -%}
        {%- when 'shield' -%}{{ icon_shield }}
        {%- when 'truck' -%}{{ icon_truck }}
        {%- when 'return' -%}{{ icon_return }}
        {%- when 'chat' -%}{{ icon_chat }}
        {%- when 'star' -%}{{ icon_star }}
        {%- when 'lock' -%}{{ icon_lock }}
        {%- when 'heart' -%}{{ icon_heart }}
        {%- when 'clock' -%}{{ icon_clock }}
        {%- when 'fire' -%}{{ icon_fire }}
        {%- when 'check' -%}{{ icon_check }}
      {%- endcase -%}
      {{ block.settings.badge_2 }}
    </li>
  {%- endif -%}
  {%- if block.settings.badge_3 != blank -%}
    <li class="cb-trust__item">
      {%- case block.settings.icon_3 -%}
        {%- when 'shield' -%}{{ icon_shield }}
        {%- when 'truck' -%}{{ icon_truck }}
        {%- when 'return' -%}{{ icon_return }}
        {%- when 'chat' -%}{{ icon_chat }}
        {%- when 'star' -%}{{ icon_star }}
        {%- when 'lock' -%}{{ icon_lock }}
        {%- when 'heart' -%}{{ icon_heart }}
        {%- when 'clock' -%}{{ icon_clock }}
        {%- when 'fire' -%}{{ icon_fire }}
        {%- when 'check' -%}{{ icon_check }}
      {%- endcase -%}
      {{ block.settings.badge_3 }}
    </li>
  {%- endif -%}
  {%- if block.settings.badge_4 != blank -%}
    <li class="cb-trust__item">
      {%- case block.settings.icon_4 -%}
        {%- when 'shield' -%}{{ icon_shield }}
        {%- when 'truck' -%}{{ icon_truck }}
        {%- when 'return' -%}{{ icon_return }}
        {%- when 'chat' -%}{{ icon_chat }}
        {%- when 'star' -%}{{ icon_star }}
        {%- when 'lock' -%}{{ icon_lock }}
        {%- when 'heart' -%}{{ icon_heart }}
        {%- when 'clock' -%}{{ icon_clock }}
        {%- when 'fire' -%}{{ icon_fire }}
        {%- when 'check' -%}{{ icon_check }}
      {%- endcase -%}
      {{ block.settings.badge_4 }}
    </li>
  {%- endif -%}
</ul>

