{{ 'cb-core.css' | asset_url | stylesheet_tag }}

{%- capture icon_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
{%- capture icon_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6H1v12h2"/><path d="M14 9h4l4 4v5h-2"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>{%- endcapture -%}
{%- capture icon_return -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v6h6"/></svg>{%- endcapture -%}
{%- capture icon_chat -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H4l1.5-3A8 8 0 1 1 21 12z"/></svg>{%- endcapture -%}
{%- capture icon_star -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endcapture -%}
{%- capture icon_lock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>{%- endcapture -%}
{%- capture icon_heart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>{%- endcapture -%}
{%- capture icon_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7v5l3.5 3.5"/></svg>{%- endcapture -%}
{%- capture icon_fire -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg>{%- endcapture -%}
{%- capture icon_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}

{%- assign bid        = block.id -%}
{%- assign layout     = block.settings.layout -%}
{%- assign mob        = block.settings.mobile_layout -%}
{%- assign scroll_dur = block.settings.scroll_speed | append: 's' -%}
{%- assign needs_scroll = false -%}
{%- if layout == 'scroll' or mob == 'scroll' -%}{%- assign needs_scroll = true -%}{%- endif -%}

{%- comment -%} Build the badge list once, output twice when scrolling {%- endcomment -%}
{%- capture badge_items -%}
  {%- assign icon_keys = 'icon_1,icon_2,icon_3,icon_4,icon_5,icon_6,icon_7,icon_8,icon_9,icon_10' | split: ',' -%}
  {%- assign text_keys = 'badge_1,badge_2,badge_3,badge_4,badge_5,badge_6,badge_7,badge_8,badge_9,badge_10' | split: ',' -%}
  {%- assign cust_keys = 'custom_icon_1,custom_icon_2,custom_icon_3,custom_icon_4,custom_icon_5,custom_icon_6,custom_icon_7,custom_icon_8,custom_icon_9,custom_icon_10' | split: ',' -%}
  {%- for i in (0..9) -%}
    {%- assign txt  = text_keys[i] -%}
    {%- assign ico  = icon_keys[i] -%}
    {%- assign cust = cust_keys[i] -%}
    {%- assign badge_text   = block.settings[txt] -%}
    {%- assign badge_icon   = block.settings[ico] -%}
    {%- assign custom_image = block.settings[cust] -%}
    {%- if badge_text != blank -%}
      <li class="cb-trust__item">
        {%- if custom_image != blank -%}
          <img class="cb-trust__img" src="{{ custom_image | image_url: width: 64 }}" alt="" loading="lazy" width="{{ block.settings.icon_size_desktop }}" height="{{ block.settings.icon_size_desktop }}">
        {%- else -%}
          {%- case badge_icon -%}
            {%- when 'shield' -%}{{ icon_shield }}
            {%- when 'truck'  -%}{{ icon_truck }}
            {%- when 'return' -%}{{ icon_return }}
            {%- when 'chat'   -%}{{ icon_chat }}
            {%- when 'star'   -%}{{ icon_star }}
            {%- when 'lock'   -%}{{ icon_lock }}
            {%- when 'heart'  -%}{{ icon_heart }}
            {%- when 'clock'  -%}{{ icon_clock }}
            {%- when 'fire'   -%}{{ icon_fire }}
            {%- when 'check'  -%}{{ icon_check }}
          {%- endcase -%}
        {%- endif -%}
        <span>{{ badge_text }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign ul_style = 'color:' | append: block.settings.color | append: ';font-size:' | append: block.settings.font_size | append: 'px;' -%}

<style>
  /* — Icon sizing — */
  #cb-trust-{{ bid }} .cb-trust__item svg,
  #cb-trust-{{ bid }} .cb-trust__img {
    width: {{ block.settings.icon_size_desktop }}px;
    height: {{ block.settings.icon_size_desktop }}px;
  }
  @media (max-width: 768px) {
    #cb-trust-{{ bid }} .cb-trust__item svg,
    #cb-trust-{{ bid }} .cb-trust__img {
      width: {{ block.settings.icon_size_tablet }}px;
      height: {{ block.settings.icon_size_tablet }}px;
    }
  }
  @media (max-width: 480px) {
    #cb-trust-{{ bid }} .cb-trust__item svg,
    #cb-trust-{{ bid }} .cb-trust__img {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }
  }

  /* — Desktop layout — */
  {%- if layout == 'vertical' -%}
  #cb-trust-{{ bid }} .cb-trust { flex-direction: column; align-items: flex-start; }
  {%- elsif layout == 'scroll' -%}
  #cb-trust-{{ bid }} { overflow: hidden; }
  #cb-trust-{{ bid }} .cb-trust-track {
    display: flex;
    width: max-content;
    animation: cb-marquee-{{ bid }} {{ scroll_dur }} linear infinite;
  }
  #cb-trust-{{ bid }} .cb-trust { flex-wrap: nowrap; }
  #cb-trust-{{ bid }} .cb-trust-track:hover { animation-play-state: paused; }
  @keyframes cb-marquee-{{ bid }} {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  {%- endif -%}

  /* — Mobile layout — */
  @media (max-width: 480px) {
    {%- if mob == 'vertical' -%}
    #cb-trust-{{ bid }} .cb-trust {
      flex-direction: column !important;
      align-items: flex-start;
      animation: none !important;
    }
    #cb-trust-{{ bid }} .cb-trust--dupe { display: none; }
    {%- elsif mob == 'horizontal' -%}
    #cb-trust-{{ bid }} .cb-trust {
      flex-direction: row !important;
      flex-wrap: wrap !important;
      animation: none !important;
    }
    #cb-trust-{{ bid }} .cb-trust--dupe { display: none; }
    {%- elsif mob == 'scroll' and layout != 'scroll' -%}
    #cb-trust-{{ bid }} { overflow: hidden; }
    #cb-trust-{{ bid }} .cb-trust-track {
      display: flex;
      width: max-content;
      animation: cb-marquee-{{ bid }} {{ scroll_dur }} linear infinite;
    }
    #cb-trust-{{ bid }} .cb-trust { flex-direction: row !important; flex-wrap: nowrap !important; }
    @keyframes cb-marquee-{{ bid }} {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    {%- endif -%}
  }
</style>

<div id="cb-trust-{{ bid }}">
  {%- if needs_scroll -%}
    <div class="cb-trust-track">
      <ul class="cb-trust" style="{{ ul_style }}" aria-label="Store guarantees">{{ badge_items }}</ul>
      <ul class="cb-trust cb-trust--dupe" style="{{ ul_style }}" aria-hidden="true">{{ badge_items }}</ul>
    </div>
  {%- else -%}
    <ul class="cb-trust" style="{{ ul_style }}" aria-label="Store guarantees">{{ badge_items }}</ul>
  {%- endif -%}
</div>

