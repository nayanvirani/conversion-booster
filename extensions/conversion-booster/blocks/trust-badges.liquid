{{ 'cb-core.css' | asset_url | stylesheet_tag }}

{%- capture default_icon -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
</svg>
{%- endcapture -%}

{%- assign bid        = block.id -%}
{%- assign layout     = block.settings.layout -%}
{%- assign mob        = block.settings.mobile_layout -%}
{%- assign scroll_dur = block.settings.scroll_speed | append: 's' -%}
{%- assign needs_scroll = false -%}
{%- if layout == 'scroll' or mob == 'scroll' -%}{%- assign needs_scroll = true -%}{%- endif -%}

{%- capture badge_items -%}
  {%- assign img_keys  = 'custom_icon_1,custom_icon_2,custom_icon_3,custom_icon_4,custom_icon_5,custom_icon_6' | split: ',' -%}
  {%- assign text_keys = 'badge_1,badge_2,badge_3,badge_4,badge_5,badge_6' | split: ',' -%}
  {%- for i in (0..5) -%}
    {%- assign badge_text   = block.settings[text_keys[i]] -%}
    {%- assign custom_image = block.settings[img_keys[i]] -%}
    {%- if badge_text != blank -%}
      <li class="cb-trust__item">
        {%- if custom_image != blank -%}
          <img class="cb-trust__img" src="{{ custom_image | image_url: width: 64 }}" alt="" loading="lazy" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}">
        {%- else -%}
          {{ default_icon }}
        {%- endif -%}
        <span>{{ badge_text }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign ul_style = 'color:' | append: block.settings.color | append: ';' -%}

<style>
  #cb-trust-{{ bid }} .cb-trust__item svg,
  #cb-trust-{{ bid }} .cb-trust__img { width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; }

  {%- if layout == 'vertical' -%}
  #cb-trust-{{ bid }} .cb-trust { flex-direction: column; align-items: flex-start; }
  {%- elsif layout == 'scroll' -%}
  #cb-trust-{{ bid }} { overflow: hidden; }
  #cb-trust-{{ bid }} .cb-trust-track { display: flex; width: max-content; animation: cbmq{{ bid }} {{ scroll_dur }} linear infinite; }
  #cb-trust-{{ bid }} .cb-trust { flex-wrap: nowrap; }
  #cb-trust-{{ bid }} .cb-trust-track:hover { animation-play-state: paused; }
  @keyframes cbmq{{ bid }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  {%- endif -%}

  @media (max-width: 480px) {
    {%- if mob == 'vertical' -%}
    #cb-trust-{{ bid }} .cb-trust { flex-direction: column !important; align-items: flex-start; animation: none !important; }
    #cb-trust-{{ bid }} .cb-trust--dupe { display: none; }
    {%- elsif mob == 'horizontal' -%}
    #cb-trust-{{ bid }} .cb-trust { flex-direction: row !important; flex-wrap: wrap !important; animation: none !important; }
    #cb-trust-{{ bid }} .cb-trust--dupe { display: none; }
    {%- elsif mob == 'scroll' and layout != 'scroll' -%}
    #cb-trust-{{ bid }} { overflow: hidden; }
    #cb-trust-{{ bid }} .cb-trust-track { display: flex; width: max-content; animation: cbmq{{ bid }} {{ scroll_dur }} linear infinite; }
    #cb-trust-{{ bid }} .cb-trust { flex-direction: row !important; flex-wrap: nowrap !important; }
    @keyframes cbmq{{ bid }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    {%- endif -%}
  }
</style>

<div id="cb-trust-{{ bid }}">
  {%- if needs_scroll -%}
    <div class="cb-trust-track">
      <ul class="cb-trust" style="{{ ul_style }}" aria-label="Store guarantees">{{ badge_items }}</ul>
      <ul class="cb-trust cb-trust--dupe" style="{{ ul_style }}" aria-hidden="true">{{ badge_items }}</ul>
    </div>
  {%- else -%}
    <ul class="cb-trust" style="{{ ul_style }}" aria-label="Store guarantees">{{ badge_items }}</ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Trust Badges",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Desktop", "default": "horizontal", "options": [
        { "value": "horizontal", "label": "Horizontal (wrap)" },
        { "value": "vertical",   "label": "Vertical list" },
        { "value": "scroll",     "label": "Infinite scroll ticker" }
    ]},
    { "type": "select", "id": "mobile_layout", "label": "Mobile", "default": "same", "options": [
        { "value": "same",       "label": "Same as desktop" },
        { "value": "horizontal", "label": "Horizontal (wrap)" },
        { "value": "vertical",   "label": "Vertical list" },
        { "value": "scroll",     "label": "Infinite scroll ticker" }
    ]},
    { "type": "range", "id": "scroll_speed", "label": "Scroll speed (seconds)", "min": 5, "max": 60, "step": 5, "default": 20, "info": "Lower = faster. Only applies in scroll mode." },

    { "type": "header", "content": "Badges — upload icon + enter text (up to 6)" },
    { "type": "image_picker", "id": "custom_icon_1", "label": "Badge 1 icon" },
    { "type": "text",         "id": "badge_1",       "label": "Badge 1 text", "default": "Secure checkout" },
    { "type": "image_picker", "id": "custom_icon_2", "label": "Badge 2 icon" },
    { "type": "text",         "id": "badge_2",       "label": "Badge 2 text", "default": "Fast delivery" },
    { "type": "image_picker", "id": "custom_icon_3", "label": "Badge 3 icon" },
    { "type": "text",         "id": "badge_3",       "label": "Badge 3 text", "default": "Easy returns" },
    { "type": "image_picker", "id": "custom_icon_4", "label": "Badge 4 icon" },
    { "type": "text",         "id": "badge_4",       "label": "Badge 4 text", "default": "24/7 support" },
    { "type": "image_picker", "id": "custom_icon_5", "label": "Badge 5 icon (optional)" },
    { "type": "text",         "id": "badge_5",       "label": "Badge 5 text" },
    { "type": "image_picker", "id": "custom_icon_6", "label": "Badge 6 icon (optional)" },
    { "type": "text",         "id": "badge_6",       "label": "Badge 6 text" },

    { "type": "header", "content": "Style" },
    { "type": "range", "id": "icon_size", "label": "Icon size (px)", "min": 14, "max": 48, "step": 2, "default": 20 },
    { "type": "color", "id": "color",     "label": "Color",          "default": "#333333" }
  ]
}
{% endschema %}
